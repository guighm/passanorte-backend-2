# Local development environment for the PassaNorte backend (spec 004).
#
# LOCAL DEVELOPMENT ONLY — never use these placeholder values in production.
# Copy this file to `.env` and adjust: `cp .env.example .env`
# `.env` is git-ignored; this example is versioned (FR-015) and must contain
# no real secrets.

# --- PostgreSQL (service `db` in compose.yaml) ---
POSTGRES_USER=passanorte
POSTGRES_PASSWORD=dev-only-password-change-me
POSTGRES_DB=passanorte

# --- API (FastAPI) — read by pydantic-settings (core/config.py) ---
# SQLAlchemy URL used by the app and Alembic. Inside Compose the host must
# be the `db` service; the `postgresql+psycopg://` prefix selects psycopg 3
# (the driver already in pyproject.toml). The compose `api` service
# overrides the host part with the same values — changing credentials here
# keeps both in sync.
DATABASE_URL=postgresql+psycopg://passanorte:dev-only-password-change-me@db:5432/passanorte

# Required with no defaults (spec 001 FR-012 / constitution Principle II):
JWT_SECRET=dev-only-jwt-secret-change-me

# LGPD sensitive-data encryption key (RNF08) — Fernet format. Generate your
# own locally with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The placeholder below is valid only as a local development example.
SENSITIVE_DATA_KEY=P7CohJ6vrbxY93i-nzqTjPrtnfbjE8pTsAa3o4Li_NI=

# --- Optional overrides (defaults live in core/config.py) ---
#JWT_TTL=3600
#JWT_REFRESH_TTL=604800
#GPS_TOLERANCE_RADIUS_M=100.0

# --- Discovery ranking (feature 013). Weights are positive and must sum
# to 1 exactly — the app refuses to start otherwise. ---
#DISCOVERY_W_PROXIMITY=0.5
#DISCOVERY_W_INTEREST=0.35
#DISCOVERY_W_EVENT=0.15
#DISCOVERY_MAX_DISTANCE_KM=10.0
#DISCOVERY_EVENT_WINDOW_DAYS=30
#DISCOVERY_EVENT_BOOST_MIN=0.25
#DISCOVERY_NEUTRAL_PROXIMITY=0.5
#DISCOVERY_MAP_PROVIDER=google_maps  # google_maps | osm (RNF18)

# --- Admin bootstrap (optional manual step, FR-020) ---
# Only consumed by the `create-admin` script (spec 002), run manually with:
#   docker compose exec api create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-only-admin-password

# --- Host ports (spec 010; all with built-in defaults — unset never breaks
# the boot). Port values are not secrets; only these defaults live here.
# INTERNAL service ports are fixed: db 5432 and dbgate 3000 — inter-service
# traffic (DATABASE_URL, DbGate preloaded connection) uses the Compose
# network, never a host port (FR-004). Changing these affects only host-side
# access (API clients, psql/IDE, browser). ---

# API_PORT is the API's REAL port: the container's uvicorn listen port AND
# the host mapping are always equal (host:container). Changing it moves the
# actual API port, not just the redirect.
API_PORT=8000

# DbGate web UI. Host mapping only — the container still listens on 3000.
DBGATE_PORT=8080

# PostgreSQL host exposure (spec 010): loopback-only (127.0.0.1), for
# psql/IDEs on this machine — never visible to other machines on the LAN.
POSTGRES_PORT=5432