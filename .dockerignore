# Minimal build context (spec 004 FR-005, SC-008): no local artifacts,
# no tests/docs/specs, no git, no secrets ever reach the image layers.

# Virtual environments and Python caches
.venv/
venv/
__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/

# Tests, specs and docs (not needed inside the image)
tests/
specs/
docs/

# Git and tooling metadata
.git/
.gitignore
.dockerignore

# Local environment files — secrets never enter the build context
.env
.env.*

# Local databases (including the repo's default dev SQLite file)
*.db
*.sqlite3

# Local build artifacts
build/
dist/
wheels/
*.egg-info/